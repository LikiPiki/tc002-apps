# Copy to config.local.toml. Only specified fields override shared defaults.
[clock]
urls = ["192.168.1.50", "192.168.1.51"]
# For per-device screen settings, replace urls with:
# profiles = ["clocks/main.local.toml", "clocks/second.local.toml"]
# Copy the corresponding files from configs/clocks/*.toml.example first.
# [clock.deploy]
# screens = ["cigar", "mackerel"]
# services = ["display-policy"]
# on_demand = []

# [clock.services.display-policy]
# schedule_enabled = true
# on = "10:00"
# off = "20:00"

# [server]
# apps = ["worker"]

# [server.worker]
# interval = "30s"

# [server.weather]
# latitude = 59.9386
# longitude = 30.3141
# label = "SPB"
# timezone = "Europe/Moscow" # Or "auto" to use the coordinates' timezone.
# screens = ["weather-current", "weather-forecast"]

# [tools]
# apps = ["clockctl"] # Use [] to skip utility build artifacts.
